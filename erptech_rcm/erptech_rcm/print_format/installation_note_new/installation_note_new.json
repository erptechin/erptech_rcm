 "html": "<div class=\"container-fluid\" id=\"container-fluid\">\n    <table class=\"table\">\n        <tbody>\n            <tr class=\"no-right-border\">\n                <td rowspan=\"3\" colspan=\"1\" class=\"no-left-border no-bottom-border  no-top-border \">\n                    <img src=\"./files/print-logo.jpeg\" class=\"img img-rounded\" align=\"left\" width=\"80\" height=\"60\">\n                </td>\n\n                <td class=\" no-bottom-border  no-top-border no-left-border\"></td>\n\n                <td colspan=\"3\" style=\"font-size: 2.0em;\" width=\"60%\" class=\"text-center top-border\"><b>BIHAR\n                        RMC</b>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</td>\n                <td class=\" no-bottom-border no-right-border no-top-border \"></td>\n            </tr>\n            <tr>\n                <td colspan=\"6\" class=\"no-left-border no-bottom-border no-right-border\">\n                    <p class=\"text-left\"><span\n                            style=\"font-size: 2.0em; float: left;\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<b>Report\n                                Title:</b>&nbsp;&nbsp;&nbsp;&nbsp; <b>Batch Sheet</b>&nbsp;&nbsp;&nbsp;<b> Plant\n                                Sl.No: 566</b></span></p>\n                </td>\n                <td class=\"no-left-border no-bottom-border no-right-border\"></td>\n                <td class=\"no-left-border no-bottom-border no-right-border\"></td>\n                <td class=\"no-left-border no-bottom-border no-right-border\"></td>\n                <td class=\"no-left-border no-bottom-border no-right-border\"></td>\n            </tr>\n        </tbody>\n    </table>\n\n    <table class=\"table1\" style=\"width: 100%\">\n        <tbody>\n            <tr>\n                <td>\n                    <table style=\"width: 90%; margin-left:1%;\">\n\n                        <tbody>\n                            <tr>\n                                <td colspan=\"2\"><strong>Batch Date</strong></td>\n\n                                <td colspan=\"2\"><span>: {{ doc.get_formatted(\"inst_date\") }}</span></td>\n\n                                <td colspan=\"2\"><strong>Batch Start Time</strong></td>\n\n                                <td colspan=\"2\"><span>: {{ doc.get_formatted(\"custom_start_time\") }}</span></td>\n\n                                <td colspan=\"2\"><strong>Batch End Time</strong></td>\n\n                                <td colspan=\"2\"><span>: {{ doc.get_formatted(\"inst_time\") }}</span></td>\n                            </tr>\n                            <tr>\n                                <td colspan=\"2\" style=\"font-size: 13px;\"><strong>Batch Number</strong></td>\n\n                                <td colspan=\"2\"><span>: 2</span></td>\n                                <td colspan=\"2\"><strong>Recipe Code</strong></td>\n\n                                <td colspan=\"2\"><span>: {{doc.custom_recipe_name}}</span></td>\n\n                                <td colspan=\"2\"><strong>Ordered Qty</strong></td>\n                                <td colspan=\"2\"><span>: {{doc.items[0].qty}}</span></td>\n                            </tr>\n                            <tr>\n                                <td colspan=\"2\"><strong>Batch Name</strong></td>\n                                <td colspan=\"2\"><span>: {{doc.items[0].description}}</span></td>\n                                <td colspan=\"2\"><strong>Recipe Name</strong></td>\n                                <td colspan=\"2\"><span>: {{doc.custom_recipe_name}}</span></td>\n                                <td colspan=\"2\"><strong>Production Qty</strong></td>\n                                <td colspan=\"2\"><span>: {{doc.items[0].custom_count}}</span></td>\n                            </tr>\n                            <tr>\n                                <td colspan=\"2\"><strong>Order Number</strong></td>\n                                <td colspan=\"2\"><span>: {{doc.items[0].custom_sales_order_no}}</span></td>\n                                <td colspan=\"2\"><strong>Truck Number</strong></td>\n                                <td colspan=\"2\"><span>: {{ doc.custom_vehicle_no }}</span></td>\n                                <td colspan=\"2\"><strong>Adj/Manual Qty</strong></td>\n                                <td colspan=\"2\"><span>: 0.00</span></td>\n                            </tr>\n                            <tr>\n                                <td colspan=\"2\"><strong>Customer</strong></td>\n                                <td colspan=\"2\"><span>: {{ doc.customer_name }}</span></td>\n                                <td colspan=\"2\"><strong>Truck Driver</strong></td>\n                                <td colspan=\"2\"><span>: {{ doc.custom_driver_name }}</span></td>\n                                <td colspan=\"2\"><strong>With This Load</strong></td>\n                                <td colspan=\"2\"><span>: 0.0</span></td>\n                            </tr>\n                            <tr>\n                                <td colspan=\"2\"><strong>Site</strong></td>\n                                <td colspan=\"2\"><span>: {{ doc.custom_site }}</span></td>\n                                <td colspan=\"2\"><strong>Batch size</strong></td>\n                                <td colspan=\"2\"><span>: {{doc.items[0].custom_batch_size}}</span></td>\n                                <td colspan=\"2\"><strong>Mixer capacity</strong></td>\n                                <td colspan=\"2\"><span>: {{ doc.custom_batch_size }}</span></td>\n                            </tr>\n\n                        </tbody>\n                    </table>\n                </td>\n            </tr>\n            <tr>\n                <td>\n                    <br>\n\n                    <table class=\"table text-center\">\n\n                        <tbody>\n\n                            <tr class=\"hide-top\">\n                                <td colspan=\"{{ doc.custom_installation_note_recipe | length }}\"\n                                    class=\"text-left no-left-border no-right-border table2-td\">\n                                    <table class=\"table2\">\n                                        <tr class=\"hide-top\">\n                                            <td class=\"text-center no-left-border no-right-border\">\n                                                <b>Aggregate</b>\n                                            </td>\n                                            <td class=\"text-center no-left-border no-right-border\"><b>Cement</b>\n                                            </td>\n                                            <td class=\"text-center no-left-border no-right-border\">\n                                                <b>Water/Ice</b>\n                                            </td>\n                                            <td class=\"text-center no-left-border no-right-border\">\n                                                <b>Admixture</b>\n                                            </td>\n                                            <td class=\"text-center no-left-border no-right-border\"><b>Silica</b>\n                                            </td>\n                                        </tr>\n                                    </table>\n                                </td>\n                            </tr>\n\n                            <tr>\n                                {%- for row in doc.custom_installation_note_recipe -%}\n                                <td style=\"border: 1.0px solid #80808073\"><b>{{ row.item_name }}</b></td>\n                                {%- endfor -%}\n                            </tr>\n\n                            <tr>\n                                {%- for row in doc.custom_installation_note_recipe -%}\n                                <td style=\"border: 1.0px solid #80808073\">\n                                    {% if row.decimal %}\n                                    {{ \"%.2f\"|format(row.qty) }}\n                                    {% else %}\n                                    {{ \"%.0f\"|format(row.qty) }}\n                                    {% endif %}\n                                </td>\n                                {%- endfor -%}\n                            </tr>\n\n                            <tr>\n                                <td colspan=\"{{ doc.custom_installation_note_recipe | length -1 }}\"\n                                    class=\"text-right no-left-border no-bottom-border\"\n                                    style=\"border-right:1.5px solid black;\"><b>Mass of Recipe Targets in\n                                        Kgs.</b>&nbsp;&nbsp;&nbsp;&nbsp;</td>\n                                <td class=\"text-center\" style=\"border:2px solid black;\">\n                                    <b>{{ doc.custom_installation_note_recipe |\n                                        sum(attribute='qty') }}</b>\n                                </td>\n\n                            </tr>\n\n                            <tr>\n                                <td colspan=\"{{ doc.custom_installation_note_recipe | length }}\"\n                                    class=\"text-left no-left-border no-right-border\"><b>Target and\n                                        Actual Value with moisture correction/absorption in % and other\n                                        Corrections in Kgs.</b></td>\n                            </tr>\n\n                            {% set customNoOfBatch = (doc.items[0].custom_no_of_batch) | int %}\n\n                            {% for i in range(1, customNoOfBatch + 1) %}\n                            <tr>\n                                {%- for row in doc.custom_installation_note_recipe -%}\n                                <td style=\"border: 1.0px solid #80808073\">\n                                    {% if row.decimal %}\n                                    {{ \"%.2f\"|format(row.qty) }}\n                                    {% else %}\n                                    {{ \"%.0f\"|format(row.qty) }}\n                                    {% endif %}\n                                </td>\n                                {% endfor %}\n\n                            </tr>\n\n                            <tr>\n                                {%- for row in doc.custom_installation_note_recipe -%}\n                                {% set qtys = row.qtys.strip('[]').split(',') %}\n                                <td style=\"border: 1.0px solid #80808073\">\n                                    {% if row.decimal %}\n                                    {{ \"%.2f\"|format(qtys[i-1] | float) }}\n                                    {% else %}\n                                    {{ \"%.0f\"|format(qtys[i-1] | float) }}\n                                    {% endif %}\n                                </td>\n                                {%- endfor %}\n                            </tr>\n\n\n                            <tr>\n                                {%- for row in doc.custom_installation_note_recipe -%}\n                                <td style=\"border: 1.0px solid #80808073\">0.00</td>\n                                {% endfor %}\n                            </tr>\n\n                            <tr>\n                                {%- for row in doc.custom_installation_note_recipe -%}\n                                <td style=\"border: 1.0px solid #80808073\">0.00</td>\n                                {% endfor %}\n                            </tr>\n\n                            <tr>\n                                <td colspan=\"{{ doc.custom_installation_note_recipe | length }}\"\n                                    style=\"border-bottom: 1.0px solid #80808073; padding: 0.1em;\">\n                                </td>\n                            </tr>\n                            {%- endfor -%}\n\n                            <tr>\n                                <td colspan=\"{{ doc.custom_installation_note_recipe | length }}\"\n                                    class=\"text-left no-left-border\"><b>Total Set Weight in Kgs.</b></td>\n\n                            </tr>\n\n                            <tr>\n                                {% set ns = namespace(tars=0) %}\n                                {%- for row in doc.custom_installation_note_recipe -%}\n                                <td style=\"border: 1.0px solid #80808073\">\n                                    {% if row.decimal %}\n                                    {{ \"%.2f\"|format(row.qty * customNoOfBatch) }}\n                                    {% else %}\n                                    {{ \"%.0f\"|format(row.qty * customNoOfBatch) }}\n                                    {% endif %}\n                                </td>\n                                {% set ns.tars = ns.tars + (row.qty * customNoOfBatch) %}\n                                {%- endfor -%}\n\n                            </tr>\n                            <tr>\n                                <td colspan=\"{{ doc.custom_installation_note_recipe | length -1 }}\" class=\"text-right\"\n                                    style=\"border-right:1.5px solid black;\">\n                                    <b>Mass of Total Set Weight in Kgs.</b>\n                                </td>\n                                <td class=\"text-center\" style=\"border:2px solid black;\">\n                                    <b>{{ \"%.2f\"|format(ns.tars) }}</b>\n                                </td>\n\n                            </tr>\n\n\n                            <tr>\n                                <td colspan=\"{{ doc.custom_installation_note_recipe | length }}\"\n                                    class=\"text-left no-left-border\"><b>Total Actual Weight in Kgs.</b></td>\n\n                            </tr>\n\n                            <tr>\n                                {% set ns = namespace(tars=0) %}\n                                {%- for row in doc.custom_installation_note_recipe -%}\n                                {% set qtys = row.qtys.strip('[]').split(',') %}\n                                {% set to = namespace(total=0) %}\n                                {% for qty in qtys %}\n                                {% set to.total = to.total + qty | float %}\n                                {% endfor %}\n                                <td style=\"border: 1.0px solid #80808073\">\n                                    {% if row.decimal %}\n                                    {{ \"%.2f\"|format(to.total) }}\n                                    {% else %}\n                                    {{ \"%.0f\"|format(to.total) }}\n                                    {% endif %}\n                                </td>\n                                {% set ns.tars = ns.tars + to.total %}\n                                {%- endfor -%}\n                            </tr>\n\n                            <tr>\n                                <td colspan=\"{{ doc.custom_installation_note_recipe | length -1 }}\" class=\"text-right\"\n                                    style=\"border-right:1.5px solid black;\">\n                                    <b>Mass of Total Actual Weight in Kgs.</b>\n                                </td>\n                                <td class=\"text-center\" style=\"border:2px solid black;\">\n                                    <b>{{ \"%.2f\"|format(ns.tars) }}</b>\n                                </td>\n\n                            </tr>\n\n                            <tr>\n                                <td colspan=\"{{ doc.custom_installation_note_recipe | length }}\"\n                                    class=\"text-left no-left-border\"><b>Difference in Percentage</b></td>\n\n                            </tr>\n\n                            <tr>\n                                {%- for row in doc.custom_installation_note_recipe -%}\n                                {% set tars = row.qty * customNoOfBatch %}\n\n                                {% set qtys = row.qtys.strip('[]').split(',') %}\n                                {% set to = namespace(acts=0) %}\n                                {% for qty in qtys %}\n                                {% set to.acts = to.acts + qty | float %}\n                                {% endfor %}\n\n                                {% set factor = 1000 if row.uom == \"Liter\" else 100 %}\n\n                                {% if tars == 0 %}\n                                {% set percentage = 0.00 %}\n                                {% else %}\n                                {% set percentage = ((tars - to.acts) / tars * factor) %}\n                                {% endif %}\n\n                                <td style=\"border: 1.0px solid #80808073\" class=\"text-center\">{{\n                                    \"%.2f\"|format(percentage) }}</td>\n                                {%- endfor -%}\n                            </tr>\n\n                        </tbody>\n                    </table>\n                    <br>\n                </td>\n            </tr>\n        </tbody>\n    </table>\n    <br>\n    <br>\n    <br>\n    <br>\n    <footer>\n        <div class=\"left\">\n            <img src=\"./files/print-logo-bottom.jpeg\" alt=\"Logo\" width=\"120\" height=\"40\">\n        </div>\n        <div class=\"center\">Page 1</div>\n        <div class=\"right\">Print Date:{{ frappe.utils.now_datetime() }}</div>\n    </footer>\n</div>",

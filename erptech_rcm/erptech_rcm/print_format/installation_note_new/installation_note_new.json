 "css": "@media print {\n    @page {\n        margin-left: 15px;\n        padding: 0;\n    }\n\n    .table {\n        border: 1px solid #ABB2B9;\n        width: 90%;\n        padding: 0;\n        border-collapse: separate;\n        border-spacing: 1px;\n        font-size: 7px;\n    }\n\n    .table>tbody>tr>td,\n    .table>tbody>tr>th,\n    .table>tfoot>tr>td,\n    .table>tfoot>tr>th,\n    .table>thead>tr>td,\n    .table>thead>tr>th {\n        border: 1px solid #ABB2B9;\n        border-collapse: separate;\n        border-spacing: 1px;\n        font-size: 10px;\n        padding: 0;\n    }\n}\n\n.table tr td,\ntr th {\n    border: 1px solid black;\n    border-collapse: separate;\n    border-spacing: 1px;\n    padding: 0;\n\n}\n\n.hide-bottom {\n    border-bottom-style: hidden;\n}\n\n.hide-top {\n    border-top-style: hidden;\n}\n\n.no-top-border {\n    border-top-style: hidden !important;\n}\n\n.no-bottom-border {\n    border-bottom-style: hidden !important;\n}\n\n.no-right-border {\n    border-right-style: hidden !important;\n}\n\n.no-left-border {\n    border-left-style: hidden !important;\n}\n\n.table>tbody>tr>td,\n.table>tbody>tr>th,\n.table>tfoot>tr>td,\n.table>tfoot>tr>th,\n.table>thead>tr>td,\n.table>thead>tr>th {\n    padding: 6px;\n    line-height: 1.42857143;\n    vertical-align: top;\n    border-top: 1px solid #ddd;\n    padding: 0;\n}\n\n.table1,\nth1,\ntd1 {\n    border: 1px solid black;\n    border-collapse: collapse;\n    padding: 0;\n}\n\n.table1 span div {\n    display: inline-block;\n}\n.table1 td {\n    white-space: nowrap;\n}\n\n.hide-top .table2-td {\n    padding: 0 !important;\n    border-bottom: 0;\n}\n\n.table2 {\n    width: 100%;\n    padding: 0;\n}\n\n.table {\n    width: 95%;\n    max-width: 95%;\n    margin-bottom: 15px;\n    padding: 0px;\n    margin-left: 2%;\n}\n\n.td2 {\n    border: 3px solid black;\n    padding: 0;\n}\n\n.details {\n    position: absolute;\n    bottom: 0;\n    right: 0;\n    background: #f1f1f1;\n    padding: 10px;\n\n}\n\n.content {\n    flex: 1;\n}\n\nfooter {\n\n    padding: 10px;\n    text-align: center;\n    position: relative;\n    width: 100%;\n    bottom: 0;\n}\n\n.left {\n    float: left;\n}\n\n.center {\n    display: inline-block;\n}\n\n.right {\n    float: right;\n}\n\nfooter::after {\n    content: \"\";\n    display: table;\n    clear: both;\n}",
